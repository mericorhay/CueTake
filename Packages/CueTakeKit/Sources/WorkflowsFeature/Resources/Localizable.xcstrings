        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "multipart/form-data: video bir dosya alanında; başlık, boyut, süre ve altyazılar metin alanlarında. Çoğu yükleme API'si, Make, n8n ve Zapier ile çalışır."
          }
        }
      }
    },
