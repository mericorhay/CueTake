        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whooshes, pops, hits and a ding placed on the video's transitions, titles and zooms. Made on the phone, free to use."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videonun geçişlerine, başlıklarına ve zoom'larına whoosh, pop, darbe ve ding yerleşir. Telefonda üretilir, telifsizdir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whoosh, pop, golpes y un ding en las transiciones, títulos y zooms del video. Se crean en el teléfono, libres de uso."
          }
        }
      }
    },
