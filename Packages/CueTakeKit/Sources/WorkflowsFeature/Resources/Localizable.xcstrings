        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punch-ins and slow pushes on the starts of sentences, spaced out."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cümle başlarına, aralıklı olarak ani yakınlaşma ve yavaş zoom."
