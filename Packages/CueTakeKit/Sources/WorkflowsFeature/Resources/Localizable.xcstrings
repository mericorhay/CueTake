    "tool.aiEdit.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell the studio's AI what to do; it edits the video the way it does in the editor."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stüdyodaki AI'a ne yapacağını söyle; videoyu editörde yaptığı gibi düzenler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dile a la IA del estudio qué hacer; edita el video igual que en el editor."
          }
        }
      }
    },
    "tool.cleanup" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One-tap cleanup"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek dokunuşla temizlik"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Limpieza en un toque"
          }
        }
      }
    },
    "tool.cleanup.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes long pauses, filler sounds, doubled words and restarted sentences."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun duraklamaları, ııı'ları, tekrarlanan kelimeleri ve yeniden başlanan cümleleri çıkarır."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quita pausas largas, muletillas, palabras repetidas y frases que se empezaron de nuevo."
          }
        }
      }
    },
    "tool.bestTakes" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Best takes"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iyi çekimler"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejores tomas"
          }
        }
      }
    },
    "tool.bestTakes.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every clip shot more than once switches to its best-read take."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden fazla çekilen her klip, en iyi okunan çekimine geçer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada clip grabado más de una vez pasa a su toma mejor leída."
          }
        }
      }
    },
