    "tool.background.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blurs, dims or replaces what is behind the speaker."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşanın arkasını bulanıklaştırır, karartır ya da değiştirir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoca, oscurece o reemplaza lo que hay detrás de quien habla."
          }
        }
      }
    },
    "tool.trackFace" : {
