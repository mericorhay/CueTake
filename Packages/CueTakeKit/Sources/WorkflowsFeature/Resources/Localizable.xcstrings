    "tool.trackFace.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The frame follows the speaker's face in every clip. Takes a moment per clip."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadraj her klipte konuşanın yüzünü takip eder. Klip başına biraz sürer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
