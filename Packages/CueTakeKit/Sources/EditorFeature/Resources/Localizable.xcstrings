    "editor.timing.freezeNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One frame, held. The clip's own length no longer decides anything — drag its edge, or use the length control."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek kare, sabit tutuluyor. Klibin kendi süresi artık bir şey belirlemiyor — kenarından sürükle ya da süre kontrolünü kullan."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fotograma, sostenido. La longitud propia del clip ya no decide nada — arrastra su borde o usa el control de longitud."
          }
        }
      }
    },
    "editor.timing.held" : {
