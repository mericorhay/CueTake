    "editor.timing.freeze" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freeze"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
