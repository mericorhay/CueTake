      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a look. It lands on the timeline; drag it and pull its ends. Changes show on the picture instantly."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir görünüm seç. Zaman çizelgesine eklenir; sürükleyip uçlarını çekebilirsin. Değişiklikler görüntüde anında görünür."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un estilo. Se coloca en la línea de tiempo; arrástralo y ajusta sus extremos. Los cambios se ven al instante."
          }
        }
      }
