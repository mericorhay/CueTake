    "editor.timing.dragHint" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag the bar on the timeline to move it, pull its ends to set when it starts and stops."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaman çizelgesinde çubuğu sürükleyerek taşı, uçlarını çekerek başlangıç ve bitişini ayarla."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra la barra en el cronograma para moverla, arrástrala a los extremos para establecer cuándo comienza y termina."
          }
        }
      }
    },
    "editor.timing.duration" : {
      "extractionState" : "manual",
