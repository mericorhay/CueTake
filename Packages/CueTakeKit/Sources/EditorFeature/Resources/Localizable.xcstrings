    "editor.timing.reverseNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Written out backwards the first time you play it, then cached. The sound plays backwards too."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İlk oynatışta tersine yazılıyor, sonra önbellekten geliyor. Ses de tersine çalar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escrito al revés la primera vez que se reproduce, luego se almacena. El sonido también se reproduce al revés."
          }
        }
      }
    },
    "editor.timing.slowNote" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slow motion looks its best when the footage was shot at 60 or 120fps."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ağır çekim, görüntü 60 ya da 120 fps çekildiyse en iyi sonucu verir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El movimiento lento se ve mejor cuando el material se grabó a 60 o 120fps."
          }
        }
      }
    },
    "editor.timing.speed" : {
