    "captions.empty.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Captions come from what is actually said in your footage. It runs on the phone — nothing is uploaded — and once it is done every word has a time on it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Altyazılar görüntünde gerçekten söylenenden çıkıyor. Telefonda çalışıyor — hiçbir şey yüklenmiyor — ve bittiğinde her kelimenin bir zamanı oluyor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los subtítulos provienen de lo que realmente se dice en tu material. Se ejecuta en el teléfono — no se sube nada — y una vez terminado, cada palabra tiene su tiempo."
          }
        }
      }
    },
