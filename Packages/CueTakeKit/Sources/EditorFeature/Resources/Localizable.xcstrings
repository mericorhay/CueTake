    "editor.ai.consent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud AI sends your video's words and edit structure, and its sound for better captions, to our server. You can turn it off again in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut AI; videonun sözlerini ve kurgu yapısını, daha iyi altyazı için de sesini sunucumuza gönderir. İzni Ayarlar'dan tekrar kapatabilirsin."
          }
        }
      }
    },
