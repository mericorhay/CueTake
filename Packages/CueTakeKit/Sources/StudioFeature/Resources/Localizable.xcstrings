    "retake.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only this segment re-records. The rest of the cut stays untouched."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece bu segment yeniden çekilir. Kurgunun geri kalanına dokunulmaz."
          }
        }
      }
    },
    "retake.pace.fast": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little fast — take a breath"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz hızlı — nefes al"
