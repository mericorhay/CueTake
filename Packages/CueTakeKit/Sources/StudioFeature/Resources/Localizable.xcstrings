        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntünü görmek ve çekime başlamak için Ayarlar’dan kamera erişimine izin ver."
          }
        }
      }
    },
    "studio.capture.error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording needs attention"
