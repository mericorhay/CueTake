    "complete.title %lld": {
      "comment": "Two lines; the line break is part of the design. The argument is the segment count.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld segment\nin the can."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld segments\nin the can."
                }
              }
            }
          }
        },
        "tr": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld segment\nkutuda."
                }
              }
            }
          }
        }
      }
    },
