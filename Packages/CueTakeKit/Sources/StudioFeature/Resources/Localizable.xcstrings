{
  "sourceLanguage": "en",
  "strings": {
    "complete.chooseSegment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Which segment would you like to record again?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi bölümü tekrar çekmek istiyorsun?"
          }
        }
      }
    },
    "complete.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitti"
          }
        }
      }
    },
    "complete.edit": {
      "extractionState": "manual",
