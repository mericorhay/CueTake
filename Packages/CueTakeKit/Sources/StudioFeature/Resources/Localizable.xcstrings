    "complete.kicker %@": {
      "comment": "The argument is the take's duration, e.g. 0:30.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TAKE COMPLETE · %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ÇEKİM TAMAM · %@"
          }
        }
      }
    },
