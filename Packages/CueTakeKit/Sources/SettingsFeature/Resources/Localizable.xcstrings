    "voice.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your pace, sentence length and fillers are measured from your videos. Your openings, calls to action and the words you never use are yours to write. The prompter, the suflör and the AI follow them."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuşma hızın, cümle uzunluğun, dolgu kelimelerin videolarından ölçülür. Açılışlarını, çağrılarını ve kullanmadığın kelimeleri sen yazarsın. Teleprompter, suflör ve AI buna göre çalışır."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ritmo, longitud de frase y rellenos se miden a partir de tus videos. Tus aperturas, llamados a la acción y las palabras que nunca usas son tuyas para escribir. El presentador, el suflör y la IA los siguen."
          }
        }
      }
    },
