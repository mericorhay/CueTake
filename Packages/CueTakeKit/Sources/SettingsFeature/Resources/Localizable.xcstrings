    "cert.honesty" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only time spent editing, recording or running workflows counts; the app sitting open does not. A project counts once, when it is first exported."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca düzenleme, çekim ve Workflow çalıştırma süresi sayılır; uygulamanın boşta açık kalması sayılmaz. Bir proje ilk dışa aktarıldığında bir kez sayılır."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cuenta el tiempo dedicado a editar, grabar o ejecutar Workflows; tener la app abierta sin usarla no cuenta. Cada proyecto se cuenta una vez, al exportarlo por primera vez."
          }
        }
      }
    },
