    "cert.review.explain %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send one finished project. It is read against five criteria — structure, pacing, captions, sound, visual polish — and needs %lld of 100."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitmiş bir projeni gönder. Beş ölçüte göre okunur — yapı, tempo, altyazı, ses, görsel özen — ve 100 üzerinden %lld ister."
          }
        }
      }
    },
