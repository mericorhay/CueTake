    "account.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple verifies your identity. CueTake stores your account identifier, name if shared, and secure sign-in credentials. You can delete your account here at any time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliğini Apple doğrular. CueTake hesap kimliğini, paylaşırsan adını ve güvenli giriş bilgilerini saklar. Hesabını istediğin zaman buradan silebilirsin."
          }
        }
      }
    },
    "account.logout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çıkış yap"
          }
        }
      }
    },
