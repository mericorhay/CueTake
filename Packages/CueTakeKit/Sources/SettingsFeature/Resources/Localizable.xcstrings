    "account.delete.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesabı sil"
          }
        }
      }
    },
    "account.delete.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently removes your CueTake account, name and all account sessions, and revokes its Apple sign-in. Projects saved on this iPhone are kept. This cannot be undone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CueTake hesabın, adın ve tüm hesap oturumların kalıcı olarak silinir; Apple giriş izni kaldırılır. Bu iPhone’daki kayıtlı projeler korunur. Bu işlem geri alınamaz."
          }
        }
      }
    },
    "account.delete.pending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Account deletion is pending. Tap Delete account to finish securely."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap silme işlemi bekliyor. Güvenle tamamlamak için Hesabı sil’e dokun."
          }
        }
      }
    },
    "account.delete.reauth": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session expired. Sign in again to complete account deletion."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumun sona erdi. Hesap silmeyi tamamlamak için tekrar giriş yap."
          }
        }
      }
    },
