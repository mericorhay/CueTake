  "strings": {
    "converter.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That file could not be converted."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya dönüştürülemedi."
          }
        }
      }
    },
    "converter.jpegNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Worth knowing: .jpg and .jpeg are the same format. This only renames it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilmekte fayda var: .jpg ile .jpeg aynı format. Bu sadece adını değiştiriyor."
          }
        }
      }
    },
    "converter.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For the file something else will not accept. It all happens on the phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir yerin kabul etmediği dosya için. Hepsi telefonda oluyor."
          }
        }
      }
    },
