    "settings.apiKey.note" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connect your own accounts to make videos with AI models. Keys stay in this iPhone's Keychain and go only to the provider you choose — never to CueTake. Usage is billed to your account."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yapay zekâ modelleriyle video üretmek için kendi hesaplarını bağla. Anahtarlar bu iPhone'un Anahtar Zinciri'nde kalır ve yalnızca seçtiğin sağlayıcıya gider, CueTake'e asla. Kullanım ücreti kendi hesabına yansır."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta tus cuentas para crear videos con modelos de IA. Las claves permanecen en el llavero de este iPhone y solo se envían al proveedor que elijas — nunca a CueTake. El uso se factura a tu cuenta."
          }
        }
      }
    },
