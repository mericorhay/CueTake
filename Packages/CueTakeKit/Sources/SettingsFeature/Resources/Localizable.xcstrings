    "account.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your CueTake account?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CueTake hesabın silinsin mi?"
          }
        }
