    "settings.privacy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Projects and media are stored on this iPhone. An Apple sign-in does not turn on cloud backup. Cloud AI processes the content needed for the request when enabled. Provider keys are kept in this device’s Keychain. Account deletion removes the CueTake account and its sessions; local projects stay on your phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projelerin ve medyan bu iPhone’da saklanır. Apple ile giriş yapmak bulut yedeklemeyi açmaz. Bulut AI etkinse isteğin için gerekli içerik işlenir. Sağlayıcı anahtarları bu cihazın Anahtar Zinciri’nde tutulur. Hesabı silmek CueTake hesabını ve oturumlarını kaldırır; yerel projelerin telefonunda kalır."
          }
        }
      }
    },
