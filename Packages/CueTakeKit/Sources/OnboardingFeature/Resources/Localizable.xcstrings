{
  "sourceLanguage" : "en",
  "strings" : {
    "onboarding.1.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One sentence becomes a plan you can shoot: hook, intro, point, call to action."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek cümle, çekime hazır bir plana dönüşür: açılış, giriş, ana fikir, kapanış."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una frase se convierte en un plan que puedes grabar: gancho, introducción, punto, llamada a la acción."
          }
        }
      }
    },
    "onboarding.1.title" : {
      "comment" : "Two lines; the line break is part of the design.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say the idea.\nGet the video."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fikri söyle.\nVideoyu al."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di la idea.\nGraba el video."
          }
        }
      }
    },
    "onboarding.2.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The teleprompter listens and holds your place, line by line. You never touch the screen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teleprompter seni dinler, satırını kaybetmez. Ekrana hiç dokunmazsın."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El teleprompter escucha y mantiene tu posición, línea por línea. Nunca tocas la pantalla."
          }
        }
      }
    },
    "onboarding.2.title" : {
      "comment" : "Two lines; the line break is part of the design.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The script\nfollows you."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin\nseni takip eder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El guion\nte sigue."
          }
        }
      }
    },
    "onboarding.3.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-record a single part. Captions, timing and the rest of the video stay as they are."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece o bölümü yeniden çek. Altyazılar, süreler ve videonun kalanı olduğu gibi kalır."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regraba una sola parte. Los subtítulos, el tiempo y el resto del video se mantienen."
          }
        }
      }
    },
    "onboarding.3.title" : {
      "comment" : "Two lines; the line break is part of the design.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix one line,\nnot the take."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek cümleyi düzelt,\nçekimi değil."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige una línea,\nno la toma."
          }
        }
      }
    },
