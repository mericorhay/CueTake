    "onboarding.1.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "CueTake turns one sentence into a shootable blueprint — hook, intro, point, CTA." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "CueTake tek cümleyi çekilebilir bir taslağa çevirir — hook, giriş, ana fikir, CTA." } }
      }
    },
    "onboarding.1.title" : {
      "comment" : "Two lines; the line break is part of the design.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Say the idea.\nGet the video." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Fikri söyle.\nVideoyu al." } }
      }
    },
    "onboarding.2.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Speech-aware teleprompter keeps your place, segment by segment. No scroll wheel." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Konuşmanı duyan teleprompter yerini korur, segment segment. Kaydırma tekerine gerek yok." } }
      }
    },
    "onboarding.2.title" : {
      "comment" : "Two lines; the line break is part of the design.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The script\nfollows you." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Script\nseni takip eder." } }
      }
    },
    "onboarding.3.subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Re-record a single segment. Captions, timing and export stay intact." } },
        "tr" : { "stringUnit" : { "state" : "translated", "value" : "Tek bir segmenti yeniden çek. Altyazılar, süreler ve export olduğu gibi kalır." } }
      }
    },
    "onboarding.3.title" : {
      "comment" : "Two lines; the line break is part of the design.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Fix one line,\nnot the take." } },
