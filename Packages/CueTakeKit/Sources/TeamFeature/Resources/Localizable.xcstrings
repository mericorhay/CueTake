    "team.explainer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put a project in your team and everyone in it sees the same video, with every cut, caption and setting — and can change it."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir projeyi ekibinize koyun; ekipteki herkes aynı videoyu her kesimi, altyazısı ve ayarıyla görür — ve değiştirebilir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un proyecto a tu equipo y todos lo verán con el mismo video, cortes, subtítulos y ajustes, y podrán cambiarlo."
          }
        }
      }
    },
