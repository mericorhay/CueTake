{
  "sourceLanguage": "en",
  "strings": {
    "team.addProject %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put “%@” in this team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” projesini ekibe koy"
          }
        }
      }
    },
    "team.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "team.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a project in your team and everyone in it sees the same video, with every cut, caption and setting — and can change it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir projeyi ekibinize koyun; ekipteki herkes aynı videoyu her kesimi, altyazısı ve ayarıyla görür — ve değiştirebilir."
          }
        }
      }
    },
    "team.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit together"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birlikte düzenleyin"
          }
        }
      }
    },
    "team.inviteLink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite by link"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantıyla davet et"
          }
        }
      }
    },
    "team.inviteNearby": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite nearby"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındakini davet et"
          }
        }
      }
    },
    "team.joinNearby": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join a team nearby"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki bir ekibe katıl"
          }
        }
      }
    },
    "team.leave.end": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibi sonlandır"
          }
        }
      }
    },
    "team.leave.endMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everyone loses access to its projects. Your own copies stay on your phone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkes ekibin projelerine erişimini kaybeder. Kendi kopyaların telefonunda kalır."
          }
        }
      }
    },
    "team.leave.leave": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipten ayrıl"
          }
        }
      }
    },
    "team.leave.leaveMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will no longer see this team’s projects."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ekibin projelerini artık görmeyeceksin."
          }
        }
      }
    },
    "team.leave.title %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”"
          }
        }
      }
    },
    "team.make": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur"
          }
        }
      }
    },
    "team.make.placeholder": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New team name"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ekip adı"
          }
        }
      }
    },
    "team.notYet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teams are being switched on. Until then you can try how meeting another phone will look."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipler açılıyor. O zamana kadar başka bir telefonla buluşmanın nasıl görüneceğini deneyebilirsiniz."
          }
        }
      }
    },
    "team.pair.bringCloser %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch the tops of your phone and %@ together."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunun ve %@ cihazının üst kenarlarını birbirine değdir."
          }
        }
      }
    },
    "team.pair.card.joinedYours": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined your team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibine katıldı"
          }
        }
      }
    },
    "team.pair.card.youJoined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are in the team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekiptesin"
          }
        }
      }
    },
    "team.pair.confirm %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let %@ into your team?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ekibine katılsın mı?"
          }
        }
      }
    },
    "team.pair.declined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not let in this time"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sefer katılım onaylanmadı"
          }
        }
      }
    },
    "team.pair.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamam"
          }
        }
      }
    },
    "team.pair.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That did not go through. Try again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olmadı. Tekrar dene"
          }
        }
      }
    },
    "team.pair.found": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone found"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon bulundu"
          }
        }
      }
    },
    "team.pair.howTo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both phones need CueTake open on this screen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki telefonda da CueTake bu ekranda açık olmalı."
          }
        }
      }
    },
    "team.pair.joined": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipte"
          }
        }
      }
    },
    "team.pair.letIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let them in"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılsın"
          }
        }
      }
    },
    "team.pair.lookingInviter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the other phone to yours"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer telefonu seninkine yaklaştır"
          }
        }
      }
    },
    "team.pair.lookingJoiner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your phone to theirs"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunu onunkine yaklaştır"
          }
        }
      }
    },
    "team.pair.noICloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to iCloud to join a team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibe katılmak için iCloud’a giriş yap"
          }
        }
      }
    },
    "team.pair.notNow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdi değil"
          }
        }
      }
    },
    "team.pair.tap": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buluş"
          }
        }
      }
    },
    "team.pair.tapToMeet %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phone cannot measure distance. Tap Meet on both phones next to %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu telefon mesafe ölçemiyor. %@ yanındayken iki telefonda da Buluş’a dokun."
          }
        }
      }
    },
    "team.pair.touched": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joining…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılıyor…"
          }
        }
      }
    },
    "team.point.invite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite someone by touching the tops of your phones together, or by sending a link."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini davet etmek için telefonlarınızın üst kenarlarını birbirine değdirin ya da bağlantı gönderin."
          }
        }
      }
    },
    "team.point.private": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only people you invite can open it. Projects live in your own iCloud, encrypted — no server of ours in between."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece davet ettikleriniz açabilir. Projeler kendi iCloud’unuzda, şifreli durur — arada bizim bir sunucumuz yok."
          }
        }
      }
    },
    "team.point.sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits from each phone reach the others by themselves. When two people change the same thing, the newer change is kept and you are told."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her telefondaki değişiklik diğerlerine kendiliğinden ulaşır. İki kişi aynı şeyi değiştirirse yenisi kalır ve size söylenir."
          }
        }
      }
    },
    "team.preview.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined your team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibine katıldı"
          }
        }
      }
    },
    "team.preview.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your teammate"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekip arkadaşın"
          }
        }
      }
    },
    "team.problem": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud did not allow that. Check that you are signed in, then try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud buna izin vermedi. Giriş yaptığından emin ol ve tekrar dene."
          }
        }
      }
    },
    "team.projects %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld projects"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld proje"
          }
        }
      }
    },
    "team.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TEAM"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "EKİP"
          }
        }
      }
    },
    "team.tryLight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the light"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığı dene"
          }
        }
      }
    },
    "team.tryLight.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preview on this phone only. Nothing is shared."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu telefonda bir önizleme. Hiçbir şey paylaşılmaz."
          }
        }
      }
    }
  },
  "version": "1.0"
}
