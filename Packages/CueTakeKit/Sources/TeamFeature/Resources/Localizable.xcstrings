{
  "sourceLanguage": "en",
  "strings": {
    "team.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapat"
          }
        }
      }
    },
    "team.explainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put a project in your team and everyone in it sees the same video, with every cut, caption and setting — and can change it."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir projeyi ekibinize koyun; ekipteki herkes aynı videoyu her kesimi, altyazısı ve ayarıyla görür — ve değiştirebilir."
          }
        }
      }
    },
    "team.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit together"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birlikte düzenleyin"
          }
        }
      }
    },
    "team.notYet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Teams are being switched on. Until then you can try how meeting another phone will look."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipler açılıyor. O zamana kadar başka bir telefonla buluşmanın nasıl görüneceğini deneyebilirsiniz."
          }
        }
      }
    },
    "team.point.invite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite someone by touching the tops of your phones together, or by sending a link."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birini davet etmek için telefonlarınızın üst kenarlarını birbirine değdirin ya da bağlantı gönderin."
          }
        }
      }
    },
    "team.point.private": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only people you invite can open it. Projects live in your own iCloud, encrypted — no server of ours in between."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sadece davet ettikleriniz açabilir. Projeler kendi iCloud’unuzda, şifreli durur — arada bizim bir sunucumuz yok."
          }
        }
      }
    },
    "team.point.sync": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits from each phone reach the others by themselves. When two people change the same thing, the newer change is kept and you are told."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her telefondaki değişiklik diğerlerine kendiliğinden ulaşır. İki kişi aynı şeyi değiştirirse yenisi kalır ve size söylenir."
          }
        }
      }
    },
    "team.preview.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Joined your team"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekibine katıldı"
          }
        }
      }
    },
    "team.preview.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your teammate"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekip arkadaşın"
          }
        }
      }
    },
    "team.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TEAM"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "EKİP"
          }
        }
      }
    },
    "team.tryLight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try the light"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Işığı dene"
          }
        }
      }
    },
    "team.tryLight.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preview on this phone only. Nothing is shared."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu telefonda bir önizleme. Hiçbir şey paylaşılmaz."
          }
        }
      }
    }
  },
  "version": "1.0"
}
