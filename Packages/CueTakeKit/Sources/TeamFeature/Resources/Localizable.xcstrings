    "team.point.invite" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite someone by touching the tops of your phones together, or by sending a link."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birini davet etmek için telefonlarınızın üst kenarlarını birbirine değdirin ya da bağlantı gönderin."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a alguien tocando las partes superiores de tus teléfonos juntos, o enviando un enlace."
          }
        }
      }
    },
    "team.point.private" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only people you invite can open it. Projects live in your own iCloud, encrypted — no server of ours in between."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sadece davet ettikleriniz açabilir. Projeler kendi iCloud’unuzda, şifreli durur — arada bizim bir sunucumuz yok."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo las personas que invites pueden abrirlo. Los proyectos viven en tu propio iCloud, cifrados — sin servidor nuestro entre medio."
          }
        }
      }
    },
    "team.point.sync" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edits from each phone reach the others by themselves. When two people change the same thing, the newer change is kept and you are told."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her telefondaki değişiklik diğerlerine kendiliğinden ulaşır. İki kişi aynı şeyi değiştirirse yenisi kalır ve size söylenir."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ediciones de cada teléfono llegan a los demás por sí mismas. Cuando dos personas cambian lo mismo, se conserva el cambio más reciente y se te informa."
          }
        }
      }
    },
