        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El flujo solo indica lo que está escrito aquí. Lo que falta queda en corchetes para que lo completes."
          }
        }
      }
    },
    "suflor.brief.details.placeholder" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
