    "suflor.brief.when.minute.explain %lld": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You talk freely; %lld minutes after you press play, the prompter moves to the ad by itself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serbest konuşursun; ▶'ye bastıktan %lld dakika sonra suflör kendiliğinden reklama geçer."
          }
        }
      }
    },
