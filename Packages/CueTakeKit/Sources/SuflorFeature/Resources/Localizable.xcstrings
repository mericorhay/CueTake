      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The prompter waits before the ad until you press forward or “Start the ad now”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suflör reklamdan önce bekler; ileriye ya da “Reklamı şimdi başlat”a basınca geçer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El presentador espera antes del anuncio hasta que pulses avanzar o \"Iniciar el anuncio ahora\"."
          }
        }
      }
    },
