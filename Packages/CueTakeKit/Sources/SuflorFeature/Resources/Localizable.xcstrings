    "suflor.page.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepared with CueTake Suflör. Times are from going on stage. \"Verified in the recording\" lines were found by listening to the saved stream on the creator's phone; \"Marked by the creator\" lines are the creator's own statement."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CueTake Suflör ile hazırlandı. Süreler sahneye çıkıştan itibarendir. \"Kayıtta doğrulandı\" satırları, kaydedilen yayının yayıncının telefonunda dinlenmesiyle bulundu; \"Yayıncı işaretledi\" satırları yayıncının kendi beyanıdır."
          }
        }
      }
    },
