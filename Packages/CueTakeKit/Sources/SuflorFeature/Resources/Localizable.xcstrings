    "suflor.pdf.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süreler yayının ya da videonun başından sayılır. DOĞRULANDI satırları kayıt yayıncının telefonunda dinlenerek, o anın karesiyle bulundu; İŞARETLENDİ satırları yayıncının kendi kaydıdır. Bu belge bir teslim kanıtıdır; hukuki uyumluluk sertifikası değildir."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times are counted from the start of the stream or video. VERIFIED lines were found by listening to the recording on the creator's phone, with the moment's frame; MARKED lines are the creator's own record. This is proof of delivery, not a legal compliance certificate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tiempos se cuentan desde el inicio del stream o video. Las líneas VERIFICADAS se encontraron escuchando la grabación en el teléfono del creador, con el fotograma del momento; las líneas MARCADAS son el registro propio del creador. Esto es prueba de entrega, no un certificado de cumplimiento legal."
          }
        }
      }
    },
