    "suflor.pdf.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times are counted from the start of the stream. VERIFIED lines were found by listening to the saved stream on the creator's phone, with the moment's frame. MARKED lines are the creator's own record, ticked while live."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreler yayının başından itibaren sayılır. DOĞRULANDI satırları, kaydedilen yayın yayıncının telefonunda dinlenerek o anın karesiyle bulundu. İŞARETLENDİ satırları yayıncının canlıdayken tuttuğu kendi kaydıdır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tiempos se cuentan desde el inicio del directo. Las líneas VERIFICADO se encontraron escuchando la grabación en el teléfono del creador, con el fotograma del momento. Las líneas MARCADO son el registro del propio creador durante el directo."
          }
        }
      }
    },
