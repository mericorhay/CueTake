    "suflor.template.hook": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait, before you scroll: I have to show you %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dur, geçmeden önce sana bunu göstermem lazım: %@."
          }
