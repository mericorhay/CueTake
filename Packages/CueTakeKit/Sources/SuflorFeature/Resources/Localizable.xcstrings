    "suflor.kind.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go live on TikTok or Instagram as always. The prompter floats in a corner and rolls your sponsor's lines at your pace."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TikTok'ta, Instagram'da her zamanki gibi yayına gir. Suflör köşede süzülür, reklamın cümlelerini senin hızında akıtır."
          }
        }
      }
    },
