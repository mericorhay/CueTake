    "suflor.template.closing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanks for being here, see you next time!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada olduğunuz için teşekkürler, görüşürüz!"
          }
        }
      }
    },
    "suflor.template.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't miss it: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaçırmayın: %@"
          }
        }
      }
