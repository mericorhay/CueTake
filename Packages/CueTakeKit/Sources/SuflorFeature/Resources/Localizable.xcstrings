      }
    },
    "suflor.template.opening": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome everyone! Today we're talking about %@, so stay till the end and say hi in the chat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkese hoş geldiniz! Bugünün konusu: %@. Sonuna kadar kalın ve yoruma bir merhaba bırakın."
          }
        }
      }
    },
    "suflor.template.rescue1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have a question about it, write it, I'll answer right away."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bununla ilgili sorusu olan yazsın, hemen cevaplıyorum."
          }
        }
      }
    },
    "suflor.template.rescue2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The link is in my profile, by the way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu arada link profilimde, kaçırmayın."
          }
        }
