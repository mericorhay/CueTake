    "suflor.kind.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the brand's brief and get the lines in your voice. Read them on the studio's teleprompter, and your take becomes a report with proof for the brand."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Markanın brifini ver, kartlar senin gibi yazılsın. Stüdyoda teleprompter'dan oku; çekimden markaya kanıtlı rapor çıksın."
          }
        }
      }
    },
    "suflor.kind.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
