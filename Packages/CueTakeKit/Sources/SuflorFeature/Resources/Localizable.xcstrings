    },
    "suflor.template.topic1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop your questions in the chat, I'm reading them all."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorularınızı yoruma yazın, hepsini okuyorum."
          }
        }
      }
    },
    "suflor.template.topic2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're enjoying this, a like pushes the stream to more people."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beğendiyseniz bir beğeni atın, yayın daha çok kişiye ulaşsın."
