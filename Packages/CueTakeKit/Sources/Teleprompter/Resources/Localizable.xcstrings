    "teleprompter.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the prompter to move it, pull the corner to resize. Presets snap instantly."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşımak için prompter'ı sürükle, boyutlandırmak için köşesinden çek. Hazır düzenler anında oturur."
