    "busy.importing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bringing in your clips…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klipler alınıyor…"
          }
        }
      }
    },
