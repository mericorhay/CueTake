    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueTake records your voice and listens so the teleprompter can follow you."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueTake sesini kaydeder ve teleprompter'ın seni takip edebilmesi için konuşmanı dinler."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueTake graba tu voz y escucha para que el teleprompter te siga."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueTake saves your finished videos to your photo library."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueTake bitmiş videolarını fotoğraf arşivine kaydeder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueTake guarda tus videos terminados en tu biblioteca de fotos."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech recognition lets the teleprompter follow you and creates captions automatically."
