    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueTake uses the camera to record your videos."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CueTake videolarını çekmek için kamerayı kullanır."
