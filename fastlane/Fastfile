default_platform(:ios)

# Authenticate with App Store Connect via the API key, never an Apple ID.
# The workflow passes the key's three parts as secrets. The key secret may hold
# the raw .p8 text or a base64 blob of it depending on how it was pasted into
# GitHub — detect rather than guess.
def connect_api_key
  key_content = ENV.fetch("APP_STORE_CONNECT_API_KEY")
  app_store_connect_api_key(
    key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
    issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content: key_content,
    is_key_content_base64: !key_content.include?("BEGIN PRIVATE KEY"),
    in_house: false,
  )
end

# Read the display name out of an encrypted .mobileprovision. Only the name is
# taken from the profile — the bundle id comes from the Appfile, the same value
# Xcode builds, so there is nothing to disagree about.
def profile_name(path)
  sh("security cms -D -i '#{path}' | plutil -extract Name raw -", log: false).strip
end

platform :ios do
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    api_key = connect_api_key
    team_id = ENV["APPLE_TEAM_ID"] || "XYB3NLV654"

    # CI has no keychain and no certificates; a dev Mac already has both.
    if ENV["CI"]
      setup_ci
      import_certificate(
        certificate_path: ENV.fetch("IOS_CERT_PATH"),
        certificate_password: ENV.fetch("IOS_CERTIFICATE_PASSWORD"),
        keychain_name: "fastlane_tmp_keychain",
        keychain_password: "",
      )
    end

    profile_path = ENV.fetch("IOS_PROFILE_PATH")
    install_provisioning_profile(path: profile_path)

    # Read the name off the profile actually being installed rather than
    # hardcoding a UUID that stops matching the moment the profile is
    # regenerated (which happens every time a certificate changes).
    profile = profile_name(profile_path)
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

    UI.message("Signing #{app_id} with profile '#{profile}' (team #{team_id})")

    # Scoped to the app target. This rewrites the checked-out project.pbxproj on
    # the runner, which is discarded with the workspace at job end — nothing is
    # committed, so the project keeps Automatic signing for anyone opening it.
    update_code_signing_settings(
      path: "CueTake.xcodeproj",
      targets: ["CueTake"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      bundle_identifier: app_id,
    )

    # GitHub's workflow run counter is local to this workflow and can be lower
    # than a build already uploaded from Xcode or another pipeline. App Store
    # Connect is the authority: always continue the current marketing version's
    # build train from the greatest number Apple has accepted.
    version = get_version_number(
      xcodeproj: "CueTake.xcodeproj",
      target: "CueTake",
    )
    uploaded_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: app_id,
      version: version,
      initial_build_number: 0,
    ).to_i
    # The version lives in an xcconfig, not the pbxproj. The checked-in build is authoritative;
    # an optional migration floor may raise it but must never replace it. Replacing it is how a
    # checked-in Build 64 was accidentally archived as Build 63.
    configured_build = (File.read("Config/CueTake.xcconfig")[/CURRENT_PROJECT_VERSION\s*=\s*(\d+)/, 1] || "0").to_i
    migration_floor = (ENV["BUILD_NUMBER_FLOOR"] || "0").to_i
    build_number = [uploaded_build + 1, configured_build, migration_floor].max
    UI.success("Building CueTake #{version} (#{build_number}); latest TestFlight build is #{uploaded_build}")

    build_app(
      project: "CueTake.xcodeproj",
      scheme: "CueTake",
      configuration: "Release",
      output_directory: "build",
      output_name: "CueTake.ipa",
      export_method: "app-store",
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { app_id => profile },
        compileBitcode: false,
        uploadBitcode: false,
        uploadSymbols: true,
      },
    )

    # Wait for App Store Connect to finish processing. With
    # skip_waiting_for_build_processing:true a binary that fails processing
    # leaves the run green while nothing ever shows up in TestFlight. Waiting
    # costs ~10-20 min but turns that into a red run with the real reason.
    groups = (ENV["TESTFLIGHT_GROUPS"] || "").split(",").map(&:strip).reject(&:empty?)
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      notify_external_testers: false,
      groups: groups.empty? ? nil : groups,
    )
  end
end
