// Shared build settings for the app target.
//
// Identity and versions live here rather than inside project.pbxproj so they
// are readable in a diff and editable without opening Xcode. CI honours this
// number and only raises it when App Store Connect already has a newer build.

PRODUCT_NAME = CueTake
PRODUCT_BUNDLE_IDENTIFIER = com.orhay.cuetake
DEVELOPMENT_TEAM = XYB3NLV654
CODE_SIGN_STYLE = Automatic
// iCloud (CloudKit) and push, for shared team projects. The App Store profile carries both.
CODE_SIGN_ENTITLEMENTS = CueTake/CueTake.entitlements
// Teams are built but switched off until they have been tried on two phones. Before switching on,
// the CloudKit schema (Project, Media, Team) has to be deployed to Production — see
// docs/CUETAKE_DARTBOARD.md. Then add: SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) CUETAKE_TEAMS

MARKETING_VERSION = 0.5.0
CURRENT_PROJECT_VERSION = 160
// Runtime gate for the native Apple credential flow. CI turns this on only
// after validating that the distribution profile carries the SIWA entitlement.
CUETAKE_APPLE_SIGN_IN_ENABLED = NO

// iPhone only, iOS 26 and up — see README for why the floor is that high.
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO

SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY = YES

SWIFT_EMIT_LOC_STRINGS = YES
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
STRING_CATALOG_GENERATE_SYMBOLS = YES

ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_PREVIEWS = YES
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

GENERATE_INFOPLIST_FILE = YES
// Keys the generated Info.plist cannot express (arrays), merged into it. Kept outside the
// CueTake folder, which Xcode syncs: inside it the file would also be copied as a resource.
INFOPLIST_FILE = Config/CueTake-Info.plist
INFOPLIST_KEY_CFBundleDisplayName = CueTake
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.photography
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents = YES
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIStatusBarStyle = UIStatusBarStyleLightContent
INFOPLIST_KEY_UIUserInterfaceStyle = Dark

// Portrait everywhere except the studio, which the design also runs in
// landscape; the recording screens opt in at runtime.
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone = UIInterfaceOrientationPortrait UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight

// Permission copy is localised in Resources/InfoPlist.xcstrings; these are the
// English source strings the catalog keys off.
INFOPLIST_KEY_NSCameraUsageDescription = CueTake uses the camera to record your videos.
INFOPLIST_KEY_NSMicrophoneUsageDescription = CueTake records your voice and listens so the teleprompter can follow you.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Speech recognition lets the teleprompter follow you and creates captions automatically.
INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription = CueTake saves your finished videos to your photo library.

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
